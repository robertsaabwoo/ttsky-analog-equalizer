  save v(ot7) v(ot8) v(nt7) v(nt8) v(ock) v(ockb) v(nck) v(nckb) v(orp) v(nrp) i(Vobuf) i(Vnbuf) i(Vopd) i(Vnpd)
  tran 5p 1.1655e-07
  meas tran ota when v(ot7)=v(ot8) rise=1 td=6.000e-08
  meas tran otb when v(ot7)=v(ot8) rise=21 td=6.000e-08
  let of_mhz = 20/(otb-ota)/1e6
  print of_mhz
  let ockd = v(ock)-v(ockb)
  meas tran ock_pp pp ockd from=6.000e-08 to=1.1655e-07
  meas tran ock_min min v(ock) from=6.000e-08 to=1.1655e-07
  meas tran ock_max max v(ock) from=6.000e-08 to=1.1655e-07
