  meas tran oi_pd avg i(Vopd) from=6.000e-08 to=1.1655e-07
  meas tran nta when v(nt7)=v(nt8) rise=1 td=6.000e-08
  meas tran ntb when v(nt7)=v(nt8) rise=21 td=6.000e-08
  let nf_mhz = 20/(ntb-nta)/1e6
  print nf_mhz
  let nckd = v(nck)-v(nckb)
  meas tran nck_pp pp nckd from=6.000e-08 to=1.1655e-07
